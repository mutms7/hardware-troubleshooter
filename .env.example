# Documentation only: export/set these process variables. No .env is loaded.
# TH_BACKEND=none fails closed: no hardware backend is implemented yet.
TH_BACKEND=none
TH_JOURNAL=data/mcp_operations.sqlite3
TH_AVAILABILITY_TIMEOUT_S=1

# Leave unset until agreed with whoever implements the orchestrator.
# TH_OUTER_TIMEOUT_S=
# TH_CANCEL_GRACE_S=

# AD3 tools (docs/AD3.md). Unset TH_RIG_CONFIG disables them.
# TH_RIG_CONFIG=config/rig.json
# TH_INSTRUMENTS=ad3
# TH_AD3_SERIAL=
# TH_ARM_TIMEOUT_S=5
# TH_CAPTURES_DIR=data/captures

# Explicit software simulator only:
# TH_BACKEND=stub
# TH_STUB_SCENARIO=success
# TH_STUB_STEP_S=0.03
# TH_INSTRUMENTS=fake
# TH_FAKE_SCENARIO=success
